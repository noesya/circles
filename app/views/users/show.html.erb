<h1><%= @user %></h1>

<div class="mb-5">
  <%= link_to 'Synchroniser avec Google',
              sync_user_path,
              method: :post %>
</div>

<h2 class="mt-5">Cercle</h2>
<%= render 'people/list', people: @people_in_circle, param_name: :people_in_circle %>

<h2 class="mt-5">Interactions</h2>
<%= render 'people/list', people: @people_with_interactions, param_name: :people_with_interactions %>

<h2 class="mt-5">Import</h2>
<%= render 'people/list', people: @people_imported, param_name: :people_imported %>
