<% content_for :title, @user.to_s %>

<h1><%= @user %></h1>

<div class="my-4">
  <%= link_to "#{@user.people_imported.count} personnes importées",
              people_imported_user_path(@user), 
              class: 'me-3' %>
  <%= link_to "#{@user.people_with_interactions.count} personnes avec des interactions",
              people_with_interactions_user_path(@user), 
              class: 'me-3' %>
  <%= link_to "#{@user.interactions.count} interactions",
              interactions_user_path(@user), 
              class: 'me-3' %>
</div>
<div class="mb-5">
  <%= link_to 'Synchroniser les contacts',
              sync_people_user_path,
              method: :post, 
              class: 'btn btn-primary btn-sm' %>
  <%= link_to 'Synchroniser le calendrier',
              sync_calendar_user_path,
              method: :post, 
              class: 'btn btn-primary btn-sm' %>
  <%= link_to 'Synchroniser les mails',
              sync_mail_user_path,
              method: :post, 
              class: 'btn btn-primary btn-sm' %>
</div>

<h2 class="mt-5">Cercle</h2>
<%= render 'people/list', people: @people %>
