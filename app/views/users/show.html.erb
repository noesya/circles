<% content_for :title, @user.to_s %>

<h1><%= @user %></h1>

<div class="mb-5">
  <%= link_to 'Personnes importées',
              people_imported_user_path(@user) %><br>
  <%= link_to 'Personnes avec des interactions',
              people_with_interactions_user_path(@user) %><br>
  <%= link_to 'Interactions',
              interactions_user_path(@user) %><br>
  <%= link_to 'Synchroniser avec Google',
              sync_user_path,
              method: :post %>
</div>

<h2 class="mt-5">Cercle</h2>
<%= render 'people/list', people: @people %>
