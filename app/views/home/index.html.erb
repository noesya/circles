<% content_for :title, "Bonjour #{current_user.first_name}" %>

<h1 class="mb-5"><%= content_for(:title) %></h1>

<div class="search mb-5">
  <input type="text"
         id="person-search"
         class="form-control"
         placeholder="Rechercher une personne par nom ou prénom..."
         autocomplete="off">
  <ul id="person-search-results" class="search__results list-unstyled"></ul>
</div>

<h2 class="h4">Il faut renouer le lien avec...</h2>
<%= render 'people/list', people: @people_to_contact %>

<h2 class="h4">Tout mon cercle</h2>
<%= render 'people/list', people: @people %>