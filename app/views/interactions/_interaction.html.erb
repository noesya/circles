<%
icon = Interaction::ICONS.fetch(interaction.kind.to_sym)
%>
<li class="timeline__item">
  <div class="timeline__head d-flex justify-content-between align-items-center">
    <span class="timeline__icon">
      <%= link_to edit_interaction_path(interaction), class: 'stretched-link' do %>
        <%= bootstrap_icon(icon, width: 14, height: 14) %>
      <% end %>
    </span>
    <div class="timeline__title">
      <%= interaction.title.presence || interaction.kind_label %>
    </div>
  </div>

  <div class="timeline__date">
    <%= interaction.occurred_at.strftime("%d/%m/%Y") %>
    <% if pov == :user %>
      avec <%= interaction.person %>
    <% elsif pov == :person %>
      avec <%= interaction.user %>
    <% end %>
    <% if interaction.external_url.present? %>
      <%= link_to interaction.external_url, target: :_blank do %>
        <%= bootstrap_icon 'box-arrow-up-right', width: 12, height: 12 %>
      <% end %>
    <% end %>

  </div>
  <% if interaction.description.present? %>
    <div class="timeline__description"><%= interaction.description %></div>
  <% end %>
</li>