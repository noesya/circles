<%= simple_form_for @interaction, url: @interaction.persisted? ? interaction_path(@interaction) : person_interactions_path(@interaction.person) do |f| %>
  <%= f.error_notification %>

  <div class="form-inputs">
    <%= f.input :kind, collection: Interaction.kind_options, include_blank: false %>
    <%= f.input :user_id, collection: User.all %>
    <%= f.input :occurred_at, html5: true %>
    <%= f.input :title %>
    <%= f.input :description, as: :text %>
  </div>

  <div class="form-actions">
    <%= f.button :submit %>
  </div>
<% end %>
