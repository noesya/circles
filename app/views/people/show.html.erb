<%= content_for :title, @person %>

<div class="row d-flex align-items-center">
  <div class="col-lg-3">
    <div class="avatar">
      <% if @person.avatar.attached? %>
        <%= image_tag @person.avatar,
                      class: "rounded-circle img-fluid",
                      width: 300,
                      height: 300 %>
      <% end %>
      <%= render 'people/circle', person: @person %>
    </div>
  </div>
  <div class="col-lg-9">
    <h1><%= content_for(:title) %></h1>
    <% if @person.job_title.present? || @person.company.present? %>
      <p class="text-muted"><%= @person.status %></p>
    <% end %>
  </div>
</div>
<div class="row mb-5">
  <div class="offset-lg-3 col-lg-8">
    <% if @person.last_interaction_at %>
      <div class="mb-4">
        Dernière interaction il y a <%= time_ago_in_words @person.last_interaction_at %>
      </div>
    <% end %>

    <div class="row mb-4">
      <div class="col-lg-6">
        <% if @person.emails.any? %>
          <span class="text-muted">Mail</span>
          <ul class="list-unstyled">
            <% @person.emails.each do |email| %>
              <li>
                <%= link_to email, "mailto:#{email}",
                            class: (email.obsolete? ? 'text-decoration-line-through' : 'text-decoration-none') %>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>
      <div class="col-lg-6">
        <% if @person.phones.any? %>
          <span class="text-muted">Tel</span>
          <ul class="list-unstyled">
            <% @person.phones.each do |phone| %>
              <li>
                <%= link_to phone, "tel:#{phone.canonical}",
                            class: (phone.obsolete? ? 'text-decoration-line-through' : 'text-decoration-none') %>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>
    </div>

    <div class="mb-4">
      <%= link_to 'Modifier', edit_person_path(@person), class: 'me-3' %>
      <%= link_to 'Dédoublonner', merge_person_path(@person), class: 'me-3' %>
      <%= link_to 'Masquer', hide_person_path(@person), method: :patch, class: 'text-danger' %>
    </div>

    <%= link_to @person.user, @person.user if @person.user %>
    <% if @person.google_contacts.any? %>
      <div class="small">
        <p>
          Dans les contacts Google de
          <% @person.google_contacts.each do |contact| %>
            <br><%= link_to contact.user, contact.user %> (<%= contact.resource_name %>)
          <% end %>
        </p>
      </div>
    <% end %>
  </div>
</div>

<%= render 'interactions/list',
            person: @person,
            interactions: @interactions,
            pov: :person %>


