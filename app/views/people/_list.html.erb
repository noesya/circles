<%
param_name ||= 'page'
%>
<p><%= people.total_count %> personne<%= 's' if people.many? %></p>
<div class="row mb-5">
  <% people.each do |person| %>
    <div class="person col-lg-6">
      <div class="position-relative">
        <div class="person__avatar">
          <% if person.avatar.attached? %>
            <%= image_tag person.avatar, class: 'rounded-circle' %>
          <% else %>
            <span></span>
          <% end %>
        </div>
        <%= render 'people/circle_small', person: person %>
      </div>
      <div>
        <h2 class="mb-1"><%= link_to person.to_s, person, class: 'stretched-link' %></h2>
        <p class="text-muted small"><%= person.status %></p>
      </div>
    </div>
  <% end %>
</div>
<%= paginate people, theme: 'bootstrap-5', param_name: param_name %>