
<%= simple_form_for(@person, html: { multipart: true }) do |f| %>
  <%= f.error_notification %>
  <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>

  <div class="form-inputs">
    <% if f.object.avatar.attached? %>
      <%= image_tag f.object.avatar, class: "rounded-circle mb-3", width: 100, height: 100 %>
    <% end %>
    <%= f.input :avatar, as: :file %>
    <%= f.input :first_name %>
    <%= f.input :last_name %>
    <%= f.input :company %>
    <%= f.input :job_title %>
    <%= f.input :hidden %>

    <div class="mb-3">
      <label class="form-label d-block">Mails</label>
      <div data-nested-fields="emails">
        <%= f.simple_fields_for :emails do |email_fields| %>
          <%= render 'people/form/email_fields', f: email_fields %>
        <% end %>
      </div>
      <template data-nested-template="emails">
        <%= f.simple_fields_for :emails, Person::Email.new, child_index: 'NEW_RECORD' do |email_fields| %>
          <%= render 'people/form/email_fields', f: email_fields %>
        <% end %>
      </template>
      <button type="button" class="btn btn-sm btn-outline-secondary" data-nested-add="emails">+ Ajouter un mail</button>
    </div>

    <div class="mb-3">
      <label class="form-label d-block">Téléphones</label>
      <div data-nested-fields="phones">
        <%= f.simple_fields_for :phones do |phone_fields| %>
          <%= render 'people/form/phone_fields', f: phone_fields %>
        <% end %>
      </div>
      <template data-nested-template="phones">
        <%= f.simple_fields_for :phones, Person::Phone.new, child_index: 'NEW_RECORD' do |phone_fields| %>
          <%= render 'people/form/phone_fields', f: phone_fields %>
        <% end %>
      </template>
      <button type="button" class="btn btn-sm btn-outline-secondary" data-nested-add="phones">+ Ajouter un téléphone</button>
    </div>
  </div>

  <div class="form-actions">
    <%= f.button :submit %>
  </div>
<% end %>
