<% content_for :title, 'Le grand cercle' %>

<h1 class="mb-5"><%= content_for(:title) %></h1>

<%= render 'people/search' %>

<div class="gauge">
  <div class="gauge__ok" style="width: <%= @ratio %>%">
    <%= @people_ok %> à jour
  </div>
</div>

<p class="mt-3">
  <% if @people_ko.zero? %>
    Formidable ! Tous les liens sont soignés !
  <% else %>
    Il faut renouer le contact avec <%= @people_ko %> personnes.
  <% end %>
</p>

<%= render 'people/list', people: @people %>
